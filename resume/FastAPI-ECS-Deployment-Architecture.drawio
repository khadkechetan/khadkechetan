                <mxCell id="notesBg" parent="1" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#D5DBDB;" value="" vertex="1">
                    <mxGeometry height="210" width="1810" x="170" y="1235" as="geometry"/>
                </mxCell>
                <mxCell id="notesFlow" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;spacingTop=0;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Request &amp;amp; Data Flow&lt;/b&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt;&amp;nbsp; Client resolves the API domain via Route 53 (alias record to the ALB)&lt;br&gt;&lt;b&gt;2&lt;/b&gt;&amp;nbsp; HTTPS request inspected by AWS WAF; TLS terminated at the ALB with an ACM certificate&lt;br&gt;&lt;b&gt;3&lt;/b&gt;&amp;nbsp; ALB routes to healthy Fargate tasks in both AZs (IP target group, HTTP :8000, health check /health)&lt;br&gt;&lt;b&gt;4&lt;/b&gt;&amp;nbsp; FastAPI calls the agent on Bedrock AgentCore Runtime; the agent reasons with Bedrock foundation models&lt;br&gt;&lt;b&gt;5&lt;/b&gt;&amp;nbsp; API requests and scheduler jobs read/write PostgreSQL (RDS Multi-AZ primary; standby for failover)&lt;br&gt;&lt;b&gt;6&lt;/b&gt;&amp;nbsp; Secrets Manager / Parameter Store, ECR and CloudWatch reached privately through VPC endpoints&lt;br&gt;&lt;b&gt;7&lt;/b&gt;&amp;nbsp; Containers stream logs (awslogs) to CloudWatch; metrics, alarms and X-Ray traces collected&lt;br&gt;&lt;b&gt;8&lt;/b&gt;&amp;nbsp; Target tracking on ALBRequestCountPerTarget adjusts the ECS service desired count (2–10 tasks)&lt;br&gt;&lt;b&gt;9&lt;/b&gt;&amp;nbsp; ECS distributes tasks across AZ A / AZ B for high availability&amp;nbsp;&amp;nbsp;&lt;b&gt;10&lt;/b&gt;&amp;nbsp; CI/CD builds &amp;amp; pushes images to ECR, then deploys" vertex="1">
                    <mxGeometry height="195" width="640" x="185" y="1243" as="geometry"/>
                </mxCell>
                <mxCell id="notesDesign" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#232F3E;" value="&lt;b style=&quot;font-size:13px&quot;&gt;Design Considerations&lt;/b&gt;&lt;br&gt;•&amp;nbsp; &lt;b&gt;Scheduler &amp;amp; scale-out:&lt;/b&gt; every replica runs APScheduler, so guard each job with a PostgreSQL advisory lock (pg_try_advisory_lock) to run it exactly once — or move the scheduler to a dedicated ECS service with desiredCount = 1&lt;br&gt;•&amp;nbsp; &lt;b&gt;Network isolation:&lt;/b&gt; tasks and database in private subnets with no public IPs; only the ALB is internet-facing; NAT used only for 3rd-party egress&lt;br&gt;•&amp;nbsp; &lt;b&gt;Least-privilege IAM:&lt;/b&gt; execution role (ECR pull, logs, read secrets) separate from task role (InvokeAgentRuntime, ssm:GetParameters)&lt;br&gt;•&amp;nbsp; &lt;b&gt;Encryption:&lt;/b&gt; KMS at rest for RDS, Secrets, Parameters and Logs; TLS in transit end to end&lt;br&gt;•&amp;nbsp; &lt;b&gt;Resilience:&lt;/b&gt; Multi-AZ ALB, ECS tasks, NAT and RDS; automated backups with PITR; ECS deployment circuit breaker with rollback&lt;br&gt;•&amp;nbsp; &lt;b&gt;Graceful shutdown:&lt;/b&gt; ALB deregistration delay + SIGTERM handling so in-flight requests and jobs finish on scale-in" vertex="1">
                    <mxGeometry height="195" width="680" x="845" y="1243" as="geometry"/>
                </mxCell>
